NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb://127.0.0.1:27017/social_app

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Leave SMTP_HOST empty in development: emails are printed to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Social App <no-reply@socialapp.dev>"

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=
